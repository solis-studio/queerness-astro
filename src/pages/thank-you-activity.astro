---
import Layout from '../layouts/Layout.astro';
---
<Layout noindex={true} title="Thank You | Queerness Experiences" description={"Thanks for your interest in joining an activity in Tulum."}>

<section class="contact" id="thanks" style="min-height:60vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;">
  <p class="sec-eye">Got it!</p>
  <h1>Thank you so much.<br>I'll get back to you ASAP.</h1>
  <p class="contact-lead">I'll let you know what activities I'm doing.</p>
</section>

</Layout>

<style>
  #thanks > *{margin-left:0 !important;margin-right:0 !important;}
  #thanks .contact-lead{max-width:720px;}
</style>
