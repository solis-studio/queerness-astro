---
import Layout from '../layouts/Layout.astro';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Queerness Experiences',
  description: 'Queer Tulum tours and group trips, Mexican-owned and operated. LGBTQ+ travel experiences for lesbian, sapphic, gay, bi, trans, and queer travelers.',
  url: 'https://queernessexperiences.com',
  image: 'https://queernessexperiences.com/images/group-trips-photo.jpg',
  founder: { '@type': 'Person', name: 'Santi Solis' },
  areaServed: { '@type': 'City', name: 'Tulum' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tulum', addressRegion: 'Quintana Roo', addressCountry: 'MX' },
};
---
<Layout title="Queer Tulum Tours & Group Trips | Queerness Experiences" description={"Queer Tulum tours where you swim cenotes, eat where locals eat and leave with queer friends. Mexican-owned, led by a UCLA wildlife biologist. 5.0★ on Google."}>
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

<!-- HERO — dominant H1, then photo grid, then body, then CTAs -->
<header class="hero">
  <div class="shape-y"></div>
  <div class="shape-t"></div>
  <div class="hero-text">
    <p class="hero-eye">★ Mexican-Owned &amp; Operated · LGBTQIA+ Travel Experiences in Latin America</p>
    <h1>
      <span class="l l1">Tours &amp; group trips</span>
      <span class="l l2">for queer &amp; trans</span>
      <span class="l l3">people</span>
      <span class="l l4">in Tulum.</span>
    </h1>
    <div class="hero-grid">
      <img src="/images/hero-grid-mangroves-crop.jpg" alt="Friends swimming through the mangroves in Tulum">
      <img src="/images/hero-grid-cenote-friends.jpg" alt="Friends laughing together at a cenote in Tulum">
      <img src="/images/secret-cenote-cave.jpg" alt="A couple at the entrance of the Secret Cenote in Tulum">
      <img src="/images/IMG_0477.jpeg" alt="A couple laughing together on a jungle trail in Tulum">
    </div>
    <div class="hero-body">
      <p class="hero-lead">For sapphic, queer, and trans travelers who prioritize local businesses and want to:</p>
      <div class="hero-chips">
        <span class="hero-chip">Understand the culture from an insider</span>
        <span class="hero-chip">Enjoy the outdoors and great food</span>
        <span class="hero-chip">Experience everyday life in Tulum</span>
        <span class="hero-chip">Feel affirmed for who they are</span>
      </div>
    </div>
    <div class="cta-stack">
      <a href="#tours" class="btn-p">See the Tours →</a>
      <a href="/group-trips" class="btn-s">Camp-Style Group Trips →</a>
    </div>
    <a href="#reviews" class="hero-social-proof">
      <span class="stars">★★★★★</span>
      <span>19 five-star reviews</span>
    </a>
  </div>
</header>

<!-- QUEER-FRIENDLY BAR — under hero -->
<section class="qbar">
  <p class="qbar-h">Tulum is queer and trans friendly, and that surprises people.</p>
  <div class="qbar-grid">
    <div class="qtile"><strong>Queer friendly, not queer centric</strong><span>Tulum isn't built around one queer scene, but it is queer friendly. You'll see queer and gender-diverse people any time you walk around town. Tulum even has its own Pride, organized by local activists, and the town hall is lit up in Pride colors every June, for all of June.</span></div>
  </div>
  <p class="qbar-partner">Travel agent, trip host, or group leader? <a href="#partner">Partner with us →</a></p>
</section>

<style>
  .bridge-facts-list{list-style:none;display:flex;flex-direction:column;gap:12px;margin:0 0 var(--s-md);}
  .bridge-facts-list li{display:flex;gap:10px;align-items:baseline;}
  .bfl-num{font-family:var(--ff);font-size:14px;color:var(--yellow);flex-shrink:0;}
  .bfl-text{font-size:14.5px;color:rgba(255,255,255,0.85);line-height:1.5;}
  .bfl-text strong{color:var(--white);font-weight:700;}
  .bridge .bridge-inner{flex-direction:column !important;align-items:stretch !important;gap:var(--s-md) !important;max-width:1120px;margin:0 auto;}
  .bridge .bridge-photo{width:100% !important;max-width:none;aspect-ratio:4/3 !important;object-position:center 45% !important;position:static !important;}
  .bridge .bridge-name{font-family:var(--ff);font-size:30px;line-height:1.1;text-transform:uppercase;color:var(--white);margin:var(--s-xs, 8px) 0 var(--s-sm);}
  .bridge p.bridge-intro{font-family:var(--fb);font-size:18px;line-height:1.6;text-transform:none;color:rgba(255,255,255,0.9);max-width:560px;margin:0 0 var(--s-md);}
  .bridge .bridge-facts-label{margin:0 0 var(--s-sm);}
  .bridge .bridge-facts-list{display:grid;grid-template-columns:1fr;gap:12px;margin:0 0 var(--s-md);}
  .bridge .bridge-facts-list li{border:2px solid rgba(255,255,255,0.28);padding:14px 16px;background:rgba(255,255,255,0.04);}
  .bridge .bfl-text{font-size:15px;}
  @media(min-width:900px){
    .bridge .bridge-inner{flex-direction:row !important;align-items:flex-start !important;gap:48px !important;}
    .bridge .bridge-photo{width:360px !important;aspect-ratio:4/5 !important;flex-shrink:0;position:sticky !important;top:80px;}
    .bridge .bridge-facts-list{grid-template-columns:1fr 1fr;}
    .bridge .bridge-name{font-size:38px;}
  }
  .facts-toggle{position:absolute;opacity:0;pointer-events:none;}
  .bridge .facts-more{display:none;}
  .facts-toggle:checked ~ .facts-more{display:grid;}
  .facts-btn{display:inline-block;cursor:pointer;font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--white);margin:0 0 var(--s-sm);}
  .facts-btn::before{content:'More fun facts +';}
  .facts-toggle:checked ~ .facts-btn::before{content:'Fewer fun facts \2212';}
  .bridge .bridge-more{margin-top:var(--s-sm);display:block;width:max-content;}
  .bridge .bridge-facts-list{margin-bottom:var(--s-sm);}
  .groups .groups-hero-photo{max-width:none;}
  @media(max-width:700px){.groups .groups-two-col .groups-hero-photo{width:100%;max-width:none;aspect-ratio:3/2;margin:0 0 var(--s-sm);object-position:center 30%;}}
  .gfacts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 var(--s-sm);max-width:560px;}
  .gfact{background:var(--yellow);border:3px solid var(--dark);padding:10px 12px;display:flex;flex-direction:column;gap:2px;}
  .gfact-k{font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(26,26,24,0.7);}
  .gfact-v{font-family:var(--fb);font-size:15px;font-weight:700;color:var(--dark);line-height:1.25;}
  .groups p.gline{font-size:15.5px;line-height:1.5;margin:0 0 var(--s-sm);max-width:560px;}
  .groups p.gsub{font-family:var(--fb);font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--yellow);margin:0 0 8px;}
  .gcamps{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 var(--s-sm);max-width:560px;}
  .gcamp{justify-content:center;border-left:4px solid var(--yellow);background:rgba(255,255,255,0.1);padding:10px 12px;display:flex;flex-direction:column;gap:2px;}
  .gcamp strong{font-family:var(--fb);font-size:15px;color:var(--white);}
  .gcamp span{font-size:13.5px;line-height:1.4;color:rgba(255,255,255,0.88);}
  .gbtns{display:flex;flex-wrap:wrap;gap:12px;}
  .gbtns .btn-groups{flex:1 1 220px;max-width:340px;}
  @media(min-width:720px){
    .friend .friend-inner{justify-content:flex-start !important;gap:56px !important;}
    .friend .friend-intro{flex:1;}
    .friend .friend-box{flex:1;max-width:none !important;margin-top:0 !important;}
  }
  .hero-lead{font-size:18px;color:rgba(255,255,255,0.95);margin:0 0 12px;}
  .hero-chips{display:flex;flex-wrap:wrap;gap:8px;}
  .hero-chip{background:rgba(255,255,255,0.14);border:2px solid rgba(255,255,255,0.85);color:var(--white);border-radius:999px;padding:6px 14px;font-family:var(--fb);font-size:14px;font-weight:700;line-height:1.3;}
  .friend .food-chips .food-chip{flex:1 1 auto;text-align:center;}
  .friend .btn-friend{display:block !important;width:100%;}
  .qbar{background:var(--yellow);border-bottom:6px solid var(--blue);padding:var(--s-md) var(--s-sm);}
  .qbar-h{font-family:var(--ff);font-size:22px;line-height:1.2;text-transform:uppercase;color:var(--dark);max-width:1120px;margin:0 auto var(--s-sm);}
  .qbar-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:10px;}
  .qtile{background:var(--white);border:3px solid var(--dark);box-shadow:4px 4px 0 var(--dark);padding:12px 14px;display:flex;flex-direction:column;gap:4px;}
  .qtile strong{font-family:var(--fb);font-size:15px;color:var(--dark);}
  .qtile span{font-size:14.5px;line-height:1.5;color:var(--dark);}
  @media(min-width:720px){.qbar{padding:var(--s-md) 40px;}.qbar-grid{grid-template-columns:1fr;}.qbar-h{font-size:26px;}}
  .agency{background:var(--blue);padding:var(--s-sm);}
  .agency-inner{max-width:1120px;margin:0 auto;}
  .agency-toggle{position:absolute;opacity:0;pointer-events:none;}
  .agency-q{display:flex;justify-content:space-between;align-items:center;gap:16px;cursor:pointer;padding:8px 0;}
  .agency-eye{display:block;font-family:var(--fb);font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--yellow);margin-bottom:4px;}
  .agency-h{display:block;font-family:var(--ff);font-size:20px;line-height:1.2;text-transform:uppercase;color:var(--white);}
  .agency-plus::before{content:'+';font-family:var(--fb);font-size:30px;line-height:1;color:var(--white);}
  .agency-toggle:checked ~ .agency-q .agency-plus::before{content:'\2212';}
  .agency-a{display:none;padding:var(--s-sm) 0 var(--s-sm);}
  .agency-toggle:checked ~ .agency-a,.agency:target .agency-a{display:block;}
  .agency:target .agency-plus::before{content:'\2212';}
  .qbar-partner{max-width:1120px;margin:var(--s-sm) auto 0;font-size:15.5px;color:var(--dark);}
  .qbar-partner a{font-weight:700;text-decoration:underline;color:var(--dark);}
  .agency-a p{font-size:17px;line-height:1.7;color:rgba(255,255,255,0.88);max-width:640px;margin:0 0 var(--s-sm);}
  @media(min-width:720px){.agency{padding:var(--s-sm) 40px;}}
  .tours-multi{font-size:15.5px;color:var(--muted);margin-top:var(--s-sm);text-align:center;}
  .consulting-inner{display:flex;flex-direction:column;gap:var(--s-md);align-items:center;text-align:center;max-width:1120px;margin:0 auto;}
  .consulting-photo{width:100%;max-width:420px;aspect-ratio:4/5;object-fit:cover;border:4px solid var(--white);box-shadow:6px 6px 0 var(--yellow);}
  .consulting-h{font-family:var(--ff);font-size:28px;line-height:1.2;color:var(--white);text-transform:uppercase;margin:0 0 var(--s-sm);}
  .consulting-body{font-size:17px;line-height:1.7;color:rgba(255,255,255,0.85);margin:0 0 var(--s-md);max-width:540px;}
  @media(min-width:720px){
    .consulting-inner{flex-direction:row;text-align:left;align-items:center;gap:48px;}
    .consulting-photo{max-width:360px;flex-shrink:0;}
    .consulting-text{flex:1;}
    .consulting-body{margin-left:0;margin-right:0;}
  }
</style>

<!-- BRIDGE + CREDENTIALS — one unified about-me block -->
<section class="bridge">
  <div class="bridge-inner">
    <img class="bridge-photo" src="/images/santi-hero-tulum.jpg" alt="Santi laughing in the water near Tulum, wearing a life vest">
    <div class="bridge-text">
      <p class="small" style="margin-top:0;">Meet the founder</p>
      <h2 class="bridge-name">Hi, I'm Santi (they/them).</h2>
      <p class="bridge-intro">Born in Mexico. Raised in the U.S. Came home to build a life in Tulum, where I've lived since 2017.</p>
      <p class="small bridge-facts-label">Fun facts about me</p>
      <ul class="bridge-facts-list" aria-label="Fun facts">
        <li><span class="bfl-num">01</span><span class="bfl-text"><strong>Former UCLA Wildlife Biologist</strong>: I studied marmots. Let's get nerdy about the plants and animals along the way.</span></li>
        <li><span class="bfl-num">02</span><span class="bfl-text"><strong>Local Nonprofit Committee Member</strong>: On the committee for Los Amigos de la Esquina (LADLE), which runs art, wellbeing, and life-skills programs for Mayan and local Mexican kids. Started as a volunteer, later general manager.</span></li>
      </ul>
      <input type="checkbox" id="more-facts" class="facts-toggle">
      <ul class="bridge-facts-list facts-more" aria-label="More fun facts">
        <li><span class="bfl-num">03</span><span class="bfl-text"><strong>International Conference Speaker</strong>: On designing experiences for queer and trans travelers.</span></li>
        <li><span class="bfl-num">04</span><span class="bfl-text"><strong>FOLX Campaign Model</strong>: Recently cast as a model for FOLX, the queer and trans telehealth company.</span></li>
      </ul>
      <label for="more-facts" class="facts-btn"></label>
      <a href="/about" class="bridge-more">More about me →</a>
    </div>
  </div>
</section>

<!-- GUIDE — above tours -->
<section class="guide" id="guide">
  <div class="guide-inner">
    <div>
      <div class="guide-intro">
        <p class="sec-eye" style="color:var(--yellow);">Free Tulum guide</p>
        <h2>Stop planning.<br><span class="accent">Start enjoying.</span></h2>
        <p class="guide-lead">My real recommendations for when you visit, free.</p>
      </div>
      <div class="guide-box">
        <ul class="ginc">
          <li>My favorite coffee shop, restaurant, and a queer-friendly bar</li>
          <li>No Uber in Tulum: here's the taxi app locals use for the best prices</li>
          <li>ATMs are set up to charge you on the conversion. Here's the way around it.</li>
          <li>A playlist to get you excited for the trip</li>
        </ul>
        <a href="/blog/queer-tulum-recommendations" class="btn-p" style="text-align:center;">Get the Free Tulum Guide →</a>
      </div>
    </div>
    <img class="guide-photo" src="/images/story-horse-group-coffee.jpg" alt="Friends sharing coffee and food together at a cafe table in Tulum" style="object-position:center 30%;">
  </div>
</section>

<!-- REVIEWS -->
<section class="reviews" id="reviews">
  <div class="reviews-inner">
  <p class="sec-eye" style="color:var(--yellow);">Our reviews</p>
  <h2>What queer &amp; trans<br>travelers say</h2>
  <div class="review-scroll">
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev3" class="rev-toggle">
      <p class="rtext"><strong>The website and guide were super helpful. They MADE my trip to Tulum.</strong> Santi is very responsive and knowledgeable about Tulum. I did the cenote and the street food tours and they were AMAZING. I highly highly recommend both — they were so different but each gave me a glimpse of Tulum I never would have seen without the tour. Santi is an absolute delight. The cenotes were stunning. The food was delicious. The culture and educational experience was phenomenal. I can't say enough good things.</p>
      <label for="rev3" class="rev-more"><span class="rm-more">Read more +</span><span class="rm-less">Read less −</span></label>
      <p class="rname">Chashaa Johnson, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev2" class="rev-toggle">
      <p class="rtext"><strong>Santi made exploring and connecting feel effortless</strong>, when in reality, I never would have found the spaces, knowledge, fun, and people without them.</p>
      <label for="rev2" class="rev-more"><span class="rm-more">Read more +</span><span class="rm-less">Read less −</span></label>
      <p class="rname">Haley Gowland, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev1" class="rev-toggle">
      <p class="rtext">I procrastinated in writing this review because anything I say will be an understatement to <strong>how delightful Santi is, how fantastic their tours are</strong>, and how the whole experience will easily become the highlight of any trip to Tulum.</p>
      <label for="rev1" class="rev-more"><span class="rm-more">Read more +</span><span class="rm-less">Read less −</span></label>
      <p class="rname">Kristen Eckstrand, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev4" class="rev-toggle">
      <p class="rtext">I had such an amazing time on this tour! As a foodie, I really appreciated checking out La Norteña and eating all the authentic, delicious food that Santi recommended.</p>
      <label for="rev4" class="rev-more"><span class="rm-more">Read more +</span><span class="rm-less">Read less −</span></label>
      <p class="rname">Marissa Herrera, Local Guide, Google review</p>
    </div>
  </div>
  <div class="review-scroll-nav">
    <button type="button" class="scroll-arrow scroll-arrow-left" aria-label="Scroll to previous review" onclick="this.closest('.reviews-inner').querySelector('.review-scroll').scrollBy({left:-320,behavior:'smooth'})">←</button>
    <button type="button" class="scroll-arrow scroll-arrow-right" aria-label="Scroll to next review" onclick="this.closest('.reviews-inner').querySelector('.review-scroll').scrollBy({left:320,behavior:'smooth'})">→</button>
  </div>
  <a href="https://www.google.com/maps/place/Queerness+Experiences/@20.4203707,-87.5893973,94594m/data=!3m1!1e3!4m8!3m7!1s0x213eac5d05676035:0x9ad4bb88e0a769c2!8m2!3d20.4200372!4d-87.259726!9m1!1b1!16s%2Fg%2F11w4tpph1c?hl=en" target="_blank" rel="noopener" class="btn-reviews">Read all our reviews on Google →</a>
  </div>
</section>

<!-- TOURS — two flagships + mini boxes -->
<section class="tours" id="tours">
  <div class="tours-inner">
    <p class="sec-eye">What we do</p>
    <h2>The tours</h2>
    <p class="tours-lead"><strong>Every tour is vetted so queer, trans, and gender diverse people can just focus on enjoying the day.</strong> Tours run small. Bigger group, retreat, or event? That becomes a private tour, sized and priced for your group.</p>

    <div class="food-feature">
      <p class="food-feature-caption">Eating deliciously is a priority.</p>
      <div class="food-chips">
        <span class="food-chip">Local bakeries</span>
        <span class="food-chip">Locally-owned restaurants</span>
        <span class="food-chip">Food by an amazing private chef</span>
        <span class="food-chip">Seasonal local fruit</span>
        <span class="food-chip">Tailored to dietary restrictions and allergies</span>
      </div>
    </div>

    <h3 class="tour-cat">Adventure tours</h3>
    <div class="flagship-row">
      <div class="flagship">
        <img class="ph flag-photo flag-photo-tall" src="/images/secret-cenote-cave.jpg" alt="Entering the Secret Cenote through a wooden ladder into the cave">
        <div class="flag-body">
          <div class="flag-name">Secret Cenote</div>
          <p class="flag-desc">A cenote not even locals know about. The entrance is an ancient well created by the Maya. <strong>A great option for gender diverse people who are nervous about wearing a bathing suit, because we get the cenote all to ourselves.</strong></p>
          <input type="checkbox" id="flagmore1" class="flag-toggle-check">
          <label for="flagmore1" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>You'll climb down a ladder into an entrance that used to be a well used by the ancient Maya, down into water that's been here for thousands of years. Cared for by an extremely knowledgeable Maya family.</p></div>
          <div class="flag-foot">
            <span class="flag-price"><span class="price-pp">Per person</span><span class="price-mxn">From 2,200 MXN</span><span class="price-usd">About $130 USD</span></span>
            <a href="/tours#tour1" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
      <div class="flagship">
        <img class="ph flag-photo flag-photo-tall" src="/images/muyil-river-float-group.jpg" alt="Group floating in the mangroves on the Muyil River Float tour">
        <div class="flag-body">
          <div class="flag-name">Muyil River Float</div>
          <p class="flag-desc">Relaxation tour. Float through canals built by the ancient Maya.</p>
          <input type="checkbox" id="flagmore2" class="flag-toggle-check">
          <label for="flagmore2" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Boat through lagoons and mangroves. The most relaxing day in Tulum, and the one people keep talking about when they get home.</p></div>
          <div class="flag-foot">
            <span class="flag-price"><span class="price-pp">Per person</span><span class="price-mxn">From 3,400 MXN</span><span class="price-usd">About $200 USD</span></span>
            <a href="/tours#tour2" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="flagship-row">
      <div class="flagship">
        <img class="ph flag-photo" src="/images/secret-cenote-group.jpg" alt="Friends laughing together at an open cenote on the Intro to Cenotes Tour in Tulum">
        <div class="flag-body">
          <div class="flag-name">Intro to Cenotes Tour</div>
          <p class="flag-desc">Two off-the-beaten-path cenotes, cave and open water.</p>
          <input type="checkbox" id="flagmore6" class="flag-toggle-check">
          <label for="flagmore6" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Taak Bi Ha, an amazing cave cenote with great lighting for swimming, and Nicte Ha, a fully open cenote with lily pads, cliff jumping, and amazing snorkeling.</p></div>
          <div class="flag-foot">
            <span class="flag-price"><span class="price-pp">Per person</span><span class="price-mxn">From 2,800 MXN</span><span class="price-usd">About $165 USD</span></span>
            <a href="/tours#tour-intro-cenotes" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
      <div class="flagship">
        <img class="ph flag-photo" src="/images/monkey-spotting-lagoon.jpg" alt="Looking out over the lagoon at Punta Laguna on the Monkey Spotting tour">
        <div class="flag-body">
          <div class="flag-name">Monkey Spotting + Lagoon Jungle Adventure</div>
          <p class="flag-desc">A full day in the jungle looking for wild monkeys.</p>
          <input type="checkbox" id="flagmore5" class="flag-toggle-check">
          <label for="flagmore5" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Swimming, canoeing, and zip lining over a pristine lagoon. Includes picnic lunch. Led by a UCLA wildlife biologist, so you actually understand what you're looking at.</p></div>
          <div class="flag-foot">
            <span class="flag-price"><span class="price-pp">Per person</span><span class="price-mxn">From 4,000 MXN</span><span class="price-usd">About $235 USD</span></span>
