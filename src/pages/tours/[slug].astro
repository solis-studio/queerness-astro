---
import Layout from '../../layouts/Layout.astro';
import tours from '../../data/tours.json';

export function getStaticPaths() {
  return tours.map((t) => ({ params: { slug: t.slug }, props: { tour: t } }));
}

const { tour: t } = Astro.props;
const others = tours.filter((o) => o.slug !== t.slug);
const addons = [];
if (/Optional add-on: visit a local cenote/.test(t.body)) addons.push({ value: 'Add-on: local cenote with cliff jumping', label: 'Add a local cenote with cliff jumping (+700 MXN per person, about $40 USD)' });
if (/Optional add-on: taco breakfast/.test(t.body)) addons.push({ value: 'Add-on: taco breakfast', label: 'Add a taco breakfast (+300 MXN per group, about $18 USD)' });
const choices = [
  'Secret Cenote', 'Intro to Cenotes Tour', 'Muyil River Float', 'Stories Behind the Storefronts',
  'Food Tour', 'Monkey Spotting + Lagoon Jungle Adventure', 'Group trip or retreat', 'Not sure yet',
];
const labels = { 'Monkey Spotting + Lagoon Jungle Adventure': 'Monkey Spotting', 'Not sure yet': 'Not sure yet, help me choose' };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: t.name,
  description: t.seoDescription,
  touristType: 'LGBTQ+ travelers',
  provider: { '@type': 'Organization', name: 'Queerness Experiences', url: 'https://queernessexperiences.com' },
  ...(t.price ? { offers: { '@type': 'Offer', priceCurrency: 'MXN', price: String(t.price), availability: 'https://schema.org/InStock', url: `https://queernessexperiences.com/tours/${t.slug}/` } } : {}),
};
---
<Layout title={`${t.seoTitle} | Queerness Experiences`} description={t.seoDescription} image={`https://queernessexperiences.com${t.photo}`}>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<header class="head">
  <div class="head-top">
    <div class="shape-y"></div>
    <p class="head-eye">★ Queer-led tour in Tulum</p>
    <h1>{t.name}</h1>
  </div>
  <div class="head-cols">
    <div class="head-left">
      <p class="head-body" set:html={t.oneline} />
      <a class="rating-pill" href="https://maps.google.com/?cid=11156748373462575554" target="_blank" rel="noopener">★★★★★ 5.0 · 19 Google reviews</a>
      <a href="#book" class="btn-p head-btn">Plan your tour ↓</a>
    </div>
    <div class="hero-grid head-photos">
      <img src={t.photo} alt={t.alt} loading="eager" style={`object-position:${t.heroPos};`} />
    </div>
  </div>
</header>

<nav class="tour-crumbs" aria-label="Breadcrumb"><a href="/tours/">← All tours</a></nav>

<section class="tour-detail">
  <div class="tour-body-inner" set:html={t.body} />
  <div class="tour-body-inner">
    <div class="tour-foot">
      {t.priceMxn ? (
        <span class="tour-price"><span class="price-pp">Per person</span><span class="price-mxn">{t.priceMxn}</span><span class="price-usd">{t.priceUsd}</span></span>
      ) : (
        <span class="tour-price">PRICE BY EXPERIENCE</span>
      )}
      <a href="#book" class="btn-book">Check Availability →</a>
    </div>
  </div>
</section>

<section class="confidence" aria-label="Book with confidence">
  <p class="sec-eye">Book with confidence</p>
  <div class="confidence-grid">
    <div class="confidence-tile"><strong>50% deposit</strong><span>Holds your spot once we've confirmed a date.</span></div>
    <div class="confidence-tile"><strong>Full refund</strong><span>If you cancel a week or more before your tour.</span></div>
    <div class="confidence-tile"><strong>Rain or shine</strong><span>Tours happen in any weather, and I adjust the plan on the day.</span></div>
    <div class="confidence-tile"><strong>Direct access to me</strong><span>Ask me anything before and during your trip, and get recommendations tailored to you.</span></div>
  </div>
  <a class="confidence-link" href="/policies/">Read the full cancellation policy →</a>
</section>

<section class="cta" id="book">
  <p class="cta-eye">Check availability</p>
  <h2>Let's set up<br>your tour</h2>
  <p>Tell me your dates and I'll reply within 24 hours. Once we've confirmed a date, a 50% deposit holds your spot (Zelle, Wise, or PayPal; PayPal adds a 5% fee).</p>
  <form class="cta-form" name="contact" method="POST" data-netlify="true" action="/thank-you">
    <input type="hidden" name="form-name" value="contact" />
    <div class="cta-row2">
      <input class="cta-in" type="text" name="first-name" placeholder="First name" required>
      <input class="cta-in" type="text" name="last-name" placeholder="Last name" required>
    </div>
    <input class="cta-in" type="text" name="pronouns" placeholder="Pronouns">
    <input class="cta-in" type="email" name="email" placeholder="Email" required>
    <input class="cta-in" type="tel" name="whatsapp" placeholder="WhatsApp (include country code, e.g. +1 555 123 4567)">
    <input class="cta-in" type="text" name="dates" placeholder="Dates you're coming to Tulum">
    <input class="cta-in" type="text" name="group-size" placeholder="How many people in your group?">
    <div>
      <label class="fl" style="display:block;margin-bottom:8px;">Which tour(s) interest you? Pick as many as you like</label>
      <div class="tour-checks">
        {choices.map((c) => (
          <label class="tour-check"><input type="checkbox" name="tour" value={c} checked={c === t.name} /> {labels[c] || c}</label>
        ))}
      </div>
      {addons.length > 0 && (
        <div class="addon-block">
          <label class="fl" style="display:block;margin:var(--s-sm) 0 8px;">Optional add-ons</label>
          <div class="tour-checks addon-checks">
            {addons.map((a) => (
              <label class="tour-check"><input type="checkbox" name="tour" value={a.value} /> {a.label}</label>
            ))}
          </div>
        </div>
      )}
    </div>
    <textarea class="cta-in" name="message" rows="3" placeholder="What's up? Tell me what you're looking for"></textarea>
    <button type="submit" class="btn-cta-form">Send</button>
  </form>
</section>

<section class="more-tours" aria-label="More tours">
  <p class="sec-eye">More tours</p>
  <ul class="more-tours-list">
    {others.map((o) => (<li><a href={`/tours/${o.slug}/`}>{o.name}</a></li>))}
  </ul>
  <a href="/tours/" class="more-tours-all">See all tours →</a>
</section>

<section class="group-promo" aria-label="Group trips">
  <p class="sec-eye" style="color:var(--dark);">Our other experiences</p>
  <h2>Day camp style group trips for queer grown-ups</h2>
  <p>Dates for the 2027 Tulum group trips are coming soon. Want to come sooner? Bring 3 or more friends and I'll build the itinerary.</p>
  <div class="group-promo-btns">
    <a href="/group-trips/" class="btn-p">See group trips →</a>
    <a href="/waitlist/" class="btn-p group-promo-alt">Get 2027 trip updates →</a>
  </div>
</section>
</Layout>

<style is:global>

@font-face{font-family:'CheddarGothicStencil';src:url('/fonts/CheddarGothicStencil.woff2') format('woff2');font-weight:normal;font-style:normal;font-display:swap;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{overflow-x:hidden;max-width:100vw;}
:root{
  --magenta:#C8185A;--yellow:#F5A623;--terra:#B5390F;--dark:#1a1a18;
  --white:#FDFCF9;--bone:#F5F0E8;--muted:#4A4034;--border:rgba(26,26,24,0.12);
  --s-sm:16px;--s-md:32px;--s-lg:64px;
  --ff:'Archivo Black','Space Grotesk',sans-serif;--fb:'Space Grotesk',sans-serif;
}
body{background:var(--bone);color:var(--dark);font-family:var(--fb);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
a{color:inherit;text-decoration:none;}

/* NAV */
/* HEADER */
.head{background:var(--magenta);padding:var(--s-md) var(--s-sm) var(--s-sm);position:relative;}
.head-top{position:relative;overflow:hidden;margin:calc(var(--s-md) * -1) calc(var(--s-sm) * -1) 0;padding:var(--s-md) var(--s-sm) var(--s-md);}
.shape-y{position:absolute;top:0;right:0;width:38%;height:100%;background:var(--yellow);clip-path:polygon(28% 0,100% 0,100% 100%,0 100%);z-index:0;}
.head-eye{font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.8);margin-bottom:var(--s-sm);position:relative;z-index:2;}
.head h1{font-family:var(--ff);font-size:44px;line-height:0.94;text-transform:uppercase;color:var(--white);position:relative;z-index:2;-webkit-text-stroke:1.5px rgba(0,0,0,0.3);paint-order:stroke fill;margin-bottom:var(--s-sm);}
.head p{font-size:19px;color:rgba(255,255,255,0.9);line-height:1.7;position:relative;z-index:2;max-width:520px;}

/* ACCORDION — image-first */
.tours{padding:var(--s-md) var(--s-sm) var(--s-sm);}
.tour{border:3px solid var(--dark);margin-bottom:var(--s-sm);box-shadow:5px 5px 0 var(--dark);overflow:hidden;background:var(--bone);}
.tour input{position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;}
.tour-head{cursor:pointer;position:relative;display:block;}
.tour-photo{width:100%;aspect-ratio:3/2;object-fit:cover;background:repeating-linear-gradient(135deg,rgba(26,26,24,0.05),rgba(26,26,24,0.05) 12px,rgba(26,26,24,0.09) 12px,rgba(26,26,24,0.09) 24px);display:flex;align-items:center;justify-content:center;font-size:10px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(26,26,24,0.4);text-align:center;padding:12px;border-bottom:3px solid var(--dark);}
.tour-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--white);}
.tour-oneline{margin:0;padding:0 16px 6px 16px;font-size:14px;color:var(--muted);line-height:1.5;}
.tour-name{font-family:var(--ff);font-size:22px;color:var(--dark);text-transform:uppercase;line-height:1;}
.tour-toggle{font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:var(--magenta);display:flex;align-items:center;gap:6px;text-align:left;padding:0 16px 12px;}
.tour-toggle-icon{font-size:18px;line-height:1;transition:transform 0.2s;display:inline-block;}
.tour input:checked ~ .tour-head .tour-toggle-icon{transform:rotate(45deg);}
.tour-tag{position:absolute;top:0;left:0;background:var(--magenta);color:var(--white);font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:5px 10px;border-right:3px solid var(--dark);border-bottom:3px solid var(--dark);z-index:2;}
.tour-body{max-height:0;overflow:hidden;transition:max-height 0.3s ease;background:var(--white);}
.tour input:checked ~ .tour-body{max-height:3000px;}
.tour-body-inner{padding:0 16px 18px;}
.tour-desc{font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:var(--s-sm);}
.tour-addon-photo{width:100%;aspect-ratio:16/9;object-fit:cover;border:3px solid var(--dark);box-shadow:4px 4px 0 var(--terra);margin-bottom:var(--s-sm);}
.tour-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:var(--s-sm);}
.meta-pill{font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:4px 10px;background:var(--bone);border:2px solid var(--dark);color:var(--dark);}
.tour-itin,.tour-inc{margin-bottom:var(--s-sm);}
.tour-itin-h,.tour-inc-h{font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--dark);margin-bottom:6px;}
.tour-itin-list,.tour-inc-list{list-style:none;font-size:13.5px;color:var(--muted);line-height:1.6;}
.tour-itin-list li,.tour-inc-list li{padding-left:14px;position:relative;margin-bottom:3px;}
.tour-itin-list li::before,.tour-inc-list li::before{content:'→';position:absolute;left:0;color:var(--magenta);font-weight:700;}
.tour-inc{display:flex;gap:24px;flex-wrap:wrap;}
.tour-inc>div{flex:1;min-width:160px;}
.tour-foot{display:flex;align-items:center;justify-content:space-between;border-top:2px solid var(--border);padding-top:14px;}
.tour-price{font-size:13px;font-weight:700;color:var(--dark);}
.tour-page-link{display:inline-block;margin-top:12px;font-family:var(--fb);font-size:13px;font-weight:700;color:var(--magenta);text-decoration:underline;text-underline-offset:3px;}
.btn-book{background:var(--magenta);color:var(--white);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;padding:10px 16px;border:2px solid var(--dark);box-shadow:3px 3px 0 var(--dark);}

/* NOTE */
.tours-note{background:var(--yellow);border:3px solid var(--dark);box-shadow:5px 5px 0 var(--dark);padding:16px 18px;font-size:13.5px;color:var(--dark);line-height:1.65;font-weight:500;margin-top:var(--s-md);}

/* TOURS GALLERY — scroll for more photos */
.tours-gallery-wrap{position:relative;}
.tours-gallery{display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;margin-top:var(--s-md);scroll-snap-type:x mandatory;}
.tours-gallery-nav{display:flex;justify-content:flex-end;gap:16px;margin-top:var(--s-sm);}
@media(min-width:720px){
  .head p{max-width:900px;}
  .food-feature{max-width:900px;}
}
.tours-gallery::-webkit-scrollbar{display:none;}
.tours-gallery img{flex:0 0 78%;max-width:320px;aspect-ratio:4/5;object-fit:cover;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--magenta);scroll-snap-align:start;}
@media(min-width:720px){
  .tours-gallery img{flex:0 0 260px;}
}
.tours-note strong{font-weight:700;}

/* CTA */
.cta{background:var(--magenta);padding:var(--s-lg) var(--s-sm);text-align:center;}
.cta h2{font-family:var(--ff);font-size:32px;color:var(--white);text-transform:uppercase;line-height:1;margin-bottom:var(--s-sm);}
.cta p{font-size:14px;color:rgba(255,255,255,0.7);margin-bottom:var(--s-md);line-height:1.6;}
.btn-cta{display:inline-block;background:var(--yellow);color:var(--dark);font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;padding:15px 28px;border:3px solid var(--yellow);}
.cta-eye{font-family:var(--fb);font-size:11.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--yellow);margin-bottom:12px;}
.cta-form{display:flex;flex-direction:column;gap:14px;max-width:520px;margin:var(--s-md) auto 0;text-align:left;}
.cta-row2{display:flex;gap:12px;}
.cta-row2 .cta-in{flex:1;}
.cta-in{background:var(--bone);border:2px solid var(--yellow);padding:13px 14px;font-size:15px;font-family:var(--fb);color:var(--dark);outline:none;width:100%;}
.cta-in::placeholder{color:var(--muted);}
.cta-in:focus{border-color:var(--terra);}
.cta-select{color:var(--dark);}
.cta-select option{background:var(--bone);color:var(--dark);}
.tour-checks{display:grid;grid-template-columns:1fr 1fr;gap:8px;text-align:left;}
@media(max-width:479px){.tour-checks{grid-template-columns:1fr;}}
.tour-check{display:flex;align-items:center;gap:10px;background:var(--bone);border:2px solid var(--yellow);padding:11px 14px;font-family:var(--fb);font-size:14px;color:var(--dark);cursor:pointer;}
.tour-check input{width:18px;height:18px;accent-color:var(--magenta);flex-shrink:0;cursor:pointer;}
.btn-cta-form{background:var(--yellow);color:var(--dark);padding:15px;font-size:13px;font-weight:700;font-family:var(--fb);letter-spacing:0.04em;text-transform:uppercase;border:3px solid var(--yellow);cursor:pointer;}

/* FOOTER */
footer{background:var(--blue);padding:var(--s-md) var(--s-sm);border-top:3px solid var(--yellow);display:flex;flex-direction:column;gap:var(--s-sm);}
.flogo{font-family:var(--fb);font-size:16px;font-weight:700;color:var(--magenta);line-height:1.15;}
.flinks{display:flex;flex-wrap:wrap;gap:var(--s-sm);list-style:none;}
.flinks a{font-size:12px;font-weight:500;color:rgba(255,255,255,0.5);}

@media(min-width:720px){
  nav{padding:0 40px;}
  .head{padding:var(--s-lg) 40px;}
  .head h1{font-size:64px;}
  .head-top{margin:calc(var(--s-lg) * -1) -40px 0;padding:var(--s-lg) 40px var(--s-md);}
  .tours{padding:var(--s-md) 40px var(--s-lg);max-width:1000px;margin:0 auto;}
  .tour-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start;}
  .tour{margin-bottom:0;}
  .tour-photo{aspect-ratio:1/1;}
  .cta{padding:var(--s-lg) 40px;}
  footer{flex-direction:row;align-items:center;justify-content:space-between;padding:var(--s-md) 40px;}
}

.head-cols{position:relative;z-index:2;margin-top:var(--s-sm);}
.head-k{font-family:var(--fb);font-size:12px !important;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--yellow) !important;margin:var(--s-sm) 0 8px;}
.head-chips{display:flex;flex-wrap:wrap;gap:8px;}
.head-chip{background:rgba(255,255,255,0.14);border:2px solid rgba(255,255,255,0.85);color:var(--white);border-radius:999px;padding:6px 14px;font-family:var(--fb);font-size:14px;font-weight:700;line-height:1.3;}
.head p.head-private{font-size:16px;line-height:1.55;margin:var(--s-sm) 0 0;}
.head-photos{display:none;}
#tour-list{scroll-margin-top:56px;}
.head-btn{display:table;margin-top:var(--s-sm);}
.head-left .rating-pill{display:table;}
.tours-hint{max-width:1120px;margin:0 auto var(--s-md);padding:0;font-size:16px;line-height:1.5;color:var(--muted);}
.tours-hint strong{color:var(--dark);}
@media(min-width:900px){
  .head-cols{display:grid;grid-template-columns:1fr 400px;column-gap:48px;align-items:start;}
  .head-photos{display:grid;margin:0;width:100%;}
  .head-photos img{aspect-ratio:3/2;}
  .head-left .head-body{font-size:21px;}
}
.head .head-top{padding-bottom:var(--s-xs, 12px) !important;}
.head h1{margin-bottom:0 !important;}
section#tour-reviews{background:var(--white) !important;}
section#tour-reviews h2{color:var(--dark) !important;}
section#tour-reviews .scroll-hint{color:var(--muted) !important;}
.jump-band{background:var(--bone);padding:var(--s-sm);text-align:center;border-top:3px solid var(--dark);}
.jump-band .btn-p{display:inline-block;}
.confidence{background:var(--bone);padding:var(--s-md) var(--s-sm);text-align:center;border-top:3px solid var(--dark);}
.confidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:900px;margin:0 auto var(--s-sm);}
.confidence-tile{background:var(--white);border:3px solid var(--dark);box-shadow:4px 4px 0 var(--yellow);padding:12px;display:flex;flex-direction:column;gap:5px;text-align:left;}
.confidence-tile strong{font-family:var(--ff);font-size:17px;line-height:1.1;text-transform:uppercase;color:var(--dark);font-weight:400;}
.confidence-tile span{font-size:14.5px;line-height:1.4;color:var(--dark);}
.confidence-link{font-family:var(--fb);font-size:14px;font-weight:700;color:var(--magenta);text-decoration:underline;text-underline-offset:3px;}
@media(min-width:720px){.confidence-grid{grid-template-columns:repeat(4,1fr);}.confidence-tile strong{font-size:20px;}.confidence-tile span{font-size:15.5px;}}

.head-photos{display:block !important;grid-template-columns:1fr;margin:0 0 var(--s-md);width:100%;}
.head-photos img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;transform:none !important;margin:0 !important;}
.tour-crumbs{background:var(--bone);padding:12px var(--s-sm);border-bottom:2px solid var(--dark);}
.tour-crumbs a{font-family:var(--fb);font-size:14px;font-weight:700;color:var(--magenta);text-decoration:underline;text-underline-offset:3px;}
.tour-detail{background:var(--white);padding:var(--s-md) var(--s-sm);}
.tour-detail .tour-body-inner{max-width:760px;margin:0 auto;padding:0;}
.tour-detail .tour-foot{margin-top:var(--s-sm);}
.tour-detail .tour-itin-h,.tour-detail .tour-inc-h{font-size:14px;margin-bottom:10px;}
.tour-detail .tour-itin-list,.tour-detail .tour-inc-list{font-size:17.5px;line-height:1.6;color:var(--dark);}
.tour-detail .tour-itin-list li,.tour-detail .tour-inc-list li{padding-left:22px;margin-bottom:8px;}
.tour-detail .tour-desc{font-size:17.5px;line-height:1.65;}
.tour-detail .tour-itin{margin:var(--s-md) 0;}
/* Included / not included as little squares, itinerary as numbered steps (tour pages only) */
.tour-detail .tour-inc{display:block;}
.tour-detail .tour-inc > div{margin-bottom:var(--s-sm);min-width:0;}
.tour-detail .tour-inc-list{display:flex;flex-wrap:wrap;gap:8px;}
.tour-detail .tour-inc-list li{padding:6px 12px;margin:0;background:var(--bone);border:2px solid var(--dark);font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:0.03em;text-transform:uppercase;line-height:1.3;color:var(--dark);}
.tour-detail .tour-inc-list li::before{content:'✓';position:static;display:inline;margin-right:6px;color:var(--magenta);}
.tour-detail .tour-inc > div:nth-child(2) .tour-inc-list li::before{content:'✕';color:var(--dark);}
.tour-detail .tour-itin-list{counter-reset:step;display:flex;flex-direction:column;gap:12px;}
.tour-detail .tour-itin-list li{counter-increment:step;display:flex;align-items:flex-start;gap:12px;padding:0;margin:0;font-size:18px;line-height:1.45;color:var(--dark);}
