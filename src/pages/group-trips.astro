<script>
  // Some browsers (iOS Safari, low-power mode) won't autoplay a clip inside a
  // swipe carousel until it's on screen, so nudge it to play when it scrolls in.
  document.querySelectorAll('video.camp-type-photo').forEach((v) => {
    const vid = v as HTMLVideoElement;
    const tryPlay = () => { vid.muted = true; const p = vid.play(); if (p) p.catch(() => {}); };
    new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) tryPlay(); });
    }, { threshold: 0.3 }).observe(vid);
    ['touchstart', 'click', 'scroll'].forEach((ev) => window.addEventListener(ev, () => { if (vid.paused) tryPlay(); }, { once: true, passive: true }));
  });
</script>

