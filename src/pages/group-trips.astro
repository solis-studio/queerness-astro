  { src: '/images/tulum-negro-huitlacoche-blue-corn-quesadilla.jpg', alt: 'Grilled corn, a cocktail and a blue corn quesadilla on a clay-and-wood table in Tulum' },
  { video: '/images/tulum-tacos-de-canasta-clip.mp4', poster: '/images/tulum-tacos-de-canasta-poster.jpg', alt: 'Building a plate of tacos de canasta with salsas at a local restaurant near Tulum' },
  { src: '/images/tulum-cocktail-night-out.jpg', alt: 'A smiling traveler raising a craft cocktail at a night out in Tulum' },
