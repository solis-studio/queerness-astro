---
import Layout from '../layouts/Layout.astro';
import WhyUs from '../components/WhyUs.astro';
import Highlights from '../components/Highlights.astro';
import MediaStrip from '../components/MediaStrip.astro';
const stripCamp = [
  { src: '/images/tulum-kayak-sunset-lagoon.jpg', alt: 'Two friends kayaking toward a bright orange sunset over the lagoon near Tulum' },
  { video: '/images/queer-camp-tulum-voguing-clip.mp4', poster: '/images/queer-camp-tulum-voguing-poster.jpg', alt: 'Two people voguing together under a palapa on a Camp Queerness trip in Tulum' },
  { src: '/images/tulum-friends-laughing-lagoon.jpg', alt: 'Two friends laughing together by a lagoon near Tulum' },
  { src: '/images/tulum-cenote-rope-ladder.jpg', alt: 'Climbing down a rope ladder into a cenote near Tulum' },
];
const stripWater = [
  { src: '/images/muyil-river-float-group.jpg', alt: 'Friends laughing together in a selfie on a river float near Tulum', pos: 'center 30%' },
  { video: '/images/tulum-lagoon-boat-ride-clip.mp4', poster: '/images/tulum-lagoon-boat-ride-poster.jpg', alt: 'Riding a small boat across a turquoise lagoon near Tulum' },
  { src: '/images/muyil-mangrove-swim.jpg', alt: 'Two friends floating in the lagoon near Tulum' },
  { src: '/images/punta-laguna-canoes.jpg', alt: 'Green canoes tied up at a lagoon near Tulum' },
];
const stripFood = [
  { src: '/images/tulum-negro-huitlacoche-blue-corn-quesadilla.jpg', alt: 'Grilled corn, a cocktail and a blue corn quesadilla on a clay-and-wood table in Tulum' },
  { video: '/images/tulum-tacos-de-canasta-clip.mp4', poster: '/images/tulum-tacos-de-canasta-poster.jpg', alt: 'Building a plate of tacos de canasta with salsas at a local restaurant near Tulum' },
  { src: '/images/tulum-cocktail-night-out.jpg', alt: 'A smiling traveler raising a craft cocktail at a night out in Tulum' },
  { src: '/images/tulum-street-art-mural-walk.jpg', alt: 'A traveler looking up at a large Maya woman mural on a street art walk in Tulum' },
];
const stripArt = [
  { src: '/images/tulum-watercolor-painting-mangroves.jpg', alt: 'A friend painting with watercolors at a picnic table in the mangroves near Tulum' },
  { src: '/images/tulum-la-guarida-cultural-workshop.jpg', alt: 'A group gathered for a cultural workshop at La Guarida in Tulum' },
  { src: '/images/tulum-watercolor-picnic-fresh-fruit.jpg', alt: 'Friends painting together over a spread of fresh fruit in the jungle near Tulum' },
];
const stripNature = [
  { src: '/images/tulum-birdwatching-lagoon.jpg', alt: 'Birdwatching with binoculars at a lagoon near Tulum' },
  { src: '/images/tulum-mangrove-boardwalk-walk.jpeg', alt: 'Walking through the mangrove boardwalk in Tulum' },
  { src: '/images/tulum-lagoon-dock-friends.jpg', alt: 'Two friends heading to the dock at a lagoon near Tulum' },
];
const stripAdventure = [
  { src: '/images/group-trips-photo.jpg', alt: 'A group smiling together on a Queerness Experiences trip in Tulum' },
  { video: '/images/tulum-cenote-dive-clip.mp4', poster: '/images/tulum-cenote-dive-poster.jpg', alt: 'A jump and splash into a turquoise cenote near Tulum' },
  { src: '/images/tulum-mangrove-swim-friends.jpeg', alt: 'Friends swimming through the mangroves in Tulum' },
  { src: '/images/tulum-friends-sunset-dock.jpeg', alt: 'Friends at sunset on a dock in Tulum' },
];
---
<Layout title="Queer Group Trips in Tulum, Camp-Style | Queerness Experiences" description={"Bring 3 or more friends or join the waitlist. Adventure, dance, family and team camps in Tulum with cenotes, local food and a queer local guide. Starting at $4,000 USD per person for 4 days and 5 nights."}>

<header class="head">
  <div class="head-top">
    <div class="shape-y"></div>
    <p class="head-eye">★ Queer group trips in Tulum</p>
    <h1>Queer Camp-Style<br>Group Trips</h1>
  </div>
  <div class="head-cols">
  <div class="head-left">
  <p class="head-body">Summer camp, reimagined for sapphic, queer, and trans grownups, with Mexican flair. Every trip is personalized and every activity is mix and match. Bring your friends and I'll build the itinerary, or join the waitlist for our bigger camps.</p>
  <div class="head-chips">
    <span class="head-chip">Every camp focuses on slow travel</span>
    <span class="head-chip">Exploring cenotes</span>
    <span class="head-chip">Kayaking the biosphere</span>
    <span class="head-chip">Dancing/Singing</span>
    <span class="head-chip">Arts and crafts</span>
    <span class="head-chip">Birdwatching</span>
    <span class="head-chip">Pre-Hispanic and Mexican food</span>
    <span class="head-chip">Stories with people who get it</span>
  </div>
  </div>
  <div class="hero-grid">
    <img src="/images/camp-queerness-picnic.jpg" alt="Friends painting together over a spread of fresh fruit in the jungle near Tulum" style="object-position:center 15%;">
    <img src="/images/tulum-cenote-swing-camp-queerness.jpeg" alt="Swinging out over a cenote on a Camp Queerness trip in Tulum">
    <img src="/images/tulum-lagoon-birdwatching-binoculars.jpeg" alt="Birdwatching with binoculars near a lagoon in Tulum">
    <img src="/images/tulum-friends-laughing-over-drinks.jpg" alt="Friends laughing together over drinks in Tulum">
  </div>

  </div>
</header>

<section class="trips-special">
  <Highlights kind="trips" />
</section>

<MediaStrip items={stripCamp} id="strip-camp" />

<section class="start-now">
  <div class="start-now-inner">
    <div class="start-now-text">
      <p class="sec-eye" style="color:var(--dark);">Now booking for winter</p>
      <h2>Groups of 3 or more<br>can plan a private<br>group trip now.</h2>
      <p>We'll build the itinerary around your group.</p>
      <div class="start-chips">
        <span class="start-chip">Group rates available</span>
        <span class="start-chip">Booking 3+ months ahead? Ask about an early-booking rate</span>
        <span class="start-chip">Open camp dates coming soon</span>
      </div>
    </div>
    <div class="start-now-cta">
      <a href="/bring-your-group" class="btn-groups">Plan a Group Trip →</a>
    </div>
  </div>
</section>

<MediaStrip items={stripWater} id="strip-water" label="Lagoon and river moments from our trips" />

<section class="glance" aria-label="Camp at a glance">
  <div class="glance-grid">
    <div><span class="glance-k">From</span><span class="glance-v">$4,000 USD per person</span></div>
    <div><span class="glance-k">Length</span><span class="glance-v">4 days, 5 nights</span></div>
    <div><span class="glance-k">Group size</span><span class="glance-v">3 to 13 people</span></div>
    <div><span class="glance-k">Stay</span><span class="glance-v">Private villa with a pool</span></div>
    <div><span class="glance-k">Includes</span><span class="glance-v">Airport pickups, most meals, all activities and classes</span></div>
    <div><span class="glance-k">Not included</span><span class="glance-v">Flights and alcohol</span></div>
  </div>
</section>

<WhyUs />

<MediaStrip items={stripFood} id="strip-food" label="Food and moments from our trips" />

<section class="reviews" id="reviews">
  <div class="reviews-inner">
  <p class="sec-eye">Our reviews</p>
  <h2>What people say</h2>
  <p class="reviews-sub">Reviews from our Tulum tours, guided by the same person who leads the camps.</p>
  <p class="scroll-hint">← swipe to read more →</p>
  <div class="review-scroll">
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="grev2" class="rev-toggle">
      <p class="rtext rtext-short">My partner and I booked two tours with Santi during our trip to Tulum, Street Food in the evening and Cenotes the next day. Before the trip, Santi was incredibly communicative and helpful as I planned, offering amazing local recs.</p>
      <label for="grev2" class="rev-more rev-open">Read more +</label>
      <div class="rfull"><p class="rchunk">My partner and I booked two tours with Santi during our trip to Tulum - Street Food in the evening and Cenotes the next day. Before the trip, Santi was incredibly communicative and helpful as I planned, offering amazing local recs and connections via WhatsApp, including an amazing local BnB, coffee spot, and a restaurant with some of <strong>THE BEST maiz I have ever had in my life!!</strong></p><input type="checkbox" id="grev2-s1" class="rstep"><label for="grev2-s1" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">They <strong>personalized both tours</strong> to our requests and are able to <strong>accomodate dietary restrictions</strong> if that’s your need too!<br><br>The tours themselves were a blast - Santi is so warm, curious, and personable -we enjoyed hearing about how they ended up in Tulum, and the personal ties that Santi had with some of the vendors as we walked around town.</p><input type="checkbox" id="grev2-s2" class="rstep"><label for="grev2-s2" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">The cenote tour deserves its own paragraph as it was <strong>completely magical</strong>, while also being so restorative and intentional. We started with delicious coffee and some TASTY mayan tacos followed by tranquil cenotes and A+ snacks from a local bakery.</p><input type="checkbox" id="grev2-s3" class="rstep"><label for="grev2-s3" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">Added bonus is Santi’s wildlife biology background and <strong>relationship with the owner of the cenote</strong> - they took time to introduce all of us to the owner as well as stop and point out native plants and wildlife - including some howler monkeys we happened to see that day and watched for a solid hour!!</p><input type="checkbox" id="grev2-s4" class="rstep"><label for="grev2-s4" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">My partner and I are active but also larger-bodied and Santi was incredibly thoughtful and communicative about any potential accessibility issues, and we <strong>never felt rushed or pushed</strong> to any kind of discomfort or limit.</p><input type="checkbox" id="grev2-s5" class="rstep"><label for="grev2-s5" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">It was also a gift to be guided in these experiences by another queer person as a queer couple.<br><br>If you want a thoughtful, off the beaten path, intentional and customized experience in Tulum - <strong>Santi is your person!</strong></p></div></div></div></div></div><label for="grev2" class="rev-more rev-close">Read less −</label></div>
      <p class="rname"><a href="https://maps.google.com/?cid=11156748373462575554" target="_blank" rel="noopener">Madge Dietrich</a>, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="grev1" class="rev-toggle">
      <p class="rtext rtext-short">Ay ay ay, what a time!!! Santi was a dream. The entire tour, start to finish, through Tulum and into the jungle and down into the cenote was better than I ever could've imagined.</p>
      <label for="grev1" class="rev-more rev-open">Read more +</label>
      <div class="rfull"><p class="rchunk">Ay ay ay, what a time!!! Santi was a dream. The entire tour, start to finish, through Tulum and into the jungle and down into the cenote was <strong>better than I ever could’ve imagine</strong>. It was so beautiful, and honestly <strong>is there anyone better to take you on a nature tour than a queer biologist??</strong> Are you kidding -- what a gift!!</p><input type="checkbox" id="grev1-s1" class="rstep"><label for="grev1-s1" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">Santi was so knowledgable and passionate and we could feel the deep love and respect they have for this magical place. It felt like an honor to get to be there with them and learn and experience the jungle through their eyes a bit.</p><input type="checkbox" id="grev1-s2" class="rstep"><label for="grev1-s2" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk"><strong>We felt safe to be ourselves</strong>, which means so much, and they were so fun and bright and easy to be with. It was a really special, unforgettable, almost spiritual (always spiritual), delightful experience.</p><input type="checkbox" id="grev1-s3" class="rstep"><label for="grev1-s3" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">I loved every second. Thank you so much, Santi! <strong>200/10 recommend!</strong></p></div></div></div><label for="grev1" class="rev-more rev-close">Read less −</label></div>
      <p class="rname"><a href="https://maps.google.com/?cid=11156748373462575554" target="_blank" rel="noopener">Corinna Harris</a>, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="grev3" class="rev-toggle">
      <p class="rtext rtext-short">We found Santi on Reddit while looking for queer experiences in Tulum and had a great tailored tour of the Muyil river. During the tour, they use their extensive knowledge in marine biology to share facts about the river.</p>
      <label for="grev3" class="rev-more rev-open">Read more +</label>
      <div class="rfull"><p class="rchunk">We found Santi on Reddit while looking for queer experiences in Tulum and had a great <strong>tailored tour of the Muyil river</strong>. During the tour, they use their extensive knowledge in marine biology to share facts about the river, it’s mayan trading origins, and the flora and fauna including mangrove trees, termites, and a variety of orchids.</p><input type="checkbox" id="grev3-s1" class="rstep"><label for="grev3-s1" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk">They were <strong>very accommodating</strong>, considering I recently broke a leg and brought a thoughtful picnic of in season local produce, as well as a great Mayan dish. We also visited a local non profit geared to children and experienced first hand the local impact when two young ones came to visit while we lunched.</p><input type="checkbox" id="grev3-s2" class="rstep"><label for="grev3-s2" class="rev-more rstep-label">Read more +</label><div class="rnext"><p class="rchunk"><strong>Great experience overall.</strong></p></div></div><label for="grev3" class="rev-more rev-close">Read less −</label></div>
      <p class="rname"><a href="https://maps.google.com/?cid=11156748373462575554" target="_blank" rel="noopener">Diana Ledesma</a>, Google review</p>
    </div>
  </div>
  <a href="https://www.google.com/maps/place/Queerness+Experiences/@20.4203707,-87.5893973,94594m/data=!3m1!1e3!4m8!3m7!1s0x213eac5d05676035:0x9ad4bb88e0a769c2!8m2!3d20.4200372!4d-87.259726!9m1!1b1!16s%2Fg%2F11w4tpph1c?hl=en" target="_blank" rel="noopener" class="btn-reviews">Read all reviews on Google →</a>
  </div>
</section>

<MediaStrip items={stripAdventure} id="strip-adventure" label="Adventure moments from our trips" />

<!-- PICK YOUR CAMP -->
<section class="camp-types" id="camps">
  <p class="sec-eye">Step 1: Pick your camp</p>
  <h2>Queer camps tailored<br>to your group</h2>
  <p class="camp-types-lead">The camp you pick sets the focus. Mix and match activities from any of them.</p>
  <div class="camp-inc">
    <span class="camp-inc-k">Every camp has</span>
    <span class="start-chip">A queer Tulum local planning every day</span>
    <span class="start-chip">Great local food, tailored to dietary needs</span>
    <span class="start-chip">Cenotes</span>
    <span class="start-chip">One private villa with a pool</span>
    <span class="start-chip">Small groups of 3 to 13</span>
  </div>
  <div class="camp-type-grid">
    <div class="camp-type camp-type-adventure">
      <img class="camp-type-photo" src="/images/monkey-canoe-paddle.jpg" alt="Santi smiling while paddling a canoe on a lagoon near Tulum" style="object-position:center 30%;">
      <h3>Adventure Camp</h3>
      <p class="camp-price"><strong>From $4,000 USD per person</strong><span>4 days, 5 nights. Longer trips available.</span></p>
      <p>More time outdoors, in the jungle and biosphere reserve.</p>
      <ul>
        <li>Kayak at sunset on the lagoon</li>
        <li>Row a Mayan canoe with a local team</li>
        <li>Search for birds and monkeys</li>
      </ul>
      <a href="#activities" class="camp-type-link">See all possible activities ↓</a>
    </div>
    <div class="camp-type camp-type-dance">
      <video class="camp-type-photo" src="/images/dance-class-clip.mp4" poster="/images/dance-class-pose.jpg" autoplay muted loop playsinline preload="auto" aria-label="Dancers stepping together in a dance class near Tulum" style="object-position:center 50%;"></video>
      <h3>Dance Camp</h3>
      <p class="camp-price"><strong>From $4,000 USD per person</strong><span>4 days, 5 nights. Longer trips available.</span></p>
      <p>Explore your body through dance, with no gender roles.</p>
      <ul>
        <li>Salsa, bachata, vogue, and waacking</li>
        <li>Contemporary, folk, and African dance</li>
        <li>Lead, follow, or switch, your choice</li>
      </ul>
      <a href="#activities" class="camp-type-link">See all possible activities ↓</a>
    </div>
    <div class="camp-type camp-type-family">
      <img class="camp-type-photo" src="/images/tours-gallery-picnic.jpg" alt="Three friends at a picnic table with fresh fruit and watercolors near Tulum" style="object-position:center 25%;">
      <h3>Family Camp</h3>
      <p class="camp-price"><strong>From $4,000 USD per person</strong><span>4 days, 5 nights. Longer trips available.</span></p>
      <p>For queer families, at a pace that works for every age.</p>
      <ul>
        <li>Picnics and easy outdoor days</li>
        <li>Birdwatching and wildlife spotting</li>
        <li>Slow mornings and naps</li>
      </ul>
      <a href="#activities" class="camp-type-link">See all possible activities ↓</a>
    </div>
    <div class="camp-type camp-type-team">
      <img class="camp-type-photo" src="/images/hero-jungle-group.jpg" alt="A group of friends smiling together on a jungle trail near Tulum" style="object-position:center 30%;">
      <h3>Team Bonding Camp</h3>
      <p class="camp-price"><strong>From $4,000 USD per person</strong><span>4 days, 5 nights. Longer trips available.</span></p>
      <p>For businesses and organizations, built around your team.</p>
      <ul>
        <li>Shared activities and shared meals</li>
        <li>Cultural experiences with a local guide</li>
        <li>An itinerary matched to your goals</li>
      </ul>
      <a href="#activities" class="camp-type-link">See all possible activities ↓</a>
    </div>
  </div>
  <p class="camp-swipe">← swipe to see all four camps →</p>
  <p class="camp-types-else"><strong>Don't see your camp?</strong> We build trips around anything your group is into. Tell us what you're dreaming up and we'll make it happen.</p>
</section>

<!-- "WHAT THESE TRIPS ACTUALLY ARE" — pulled 2026-09-12, written for multiple group trips, doesn't fit Camp Queerness alone. Full markup preserved in git history, may reuse pieces of this copy elsewhere later. -->

<section class="bleed" id="activities" style="--bleed:var(--white);background:var(--white);padding:var(--s-sm) var(--s-sm) var(--s-sm);max-width:1120px;margin:0 auto;">
  <p class="sec-eye">Step 2: Mix and match</p>
  <h2>Pick your<br>activities</h2>
  <p style="font-size:17px;line-height:1.65;color:var(--muted);max-width:640px;margin-top:var(--s-sm);">Mix and match across every camp. Here are a few examples.</p>

  <div class="activity-group activity-group-do">
  <label for="act1" class="act-cover"><img src="/images/tulum-lagoon-kayak-sunset-peace-sign.jpeg" alt="A kayaker raising both arms in a peace sign at sunset on the lagoon near Tulum" style="object-position:center 55%;" loading="lazy"></label>
  <input type="checkbox" class="act-toggle" id="act1">
  <label for="act1" class="activity-group-h">Things you'll do</label>
  <div class="activity-boxes">
    <div class="activity-box">Kayak at sunset on the lagoon</div>
    <div class="activity-box">Float through canals built by the ancient Maya</div>
    <div class="activity-box">Explore a private cenote</div>
    <div class="activity-box">Search for birds and monkeys in the jungle</div>
    <input type="checkbox" id="more-do" class="more-toggle">
    <div class="more-wrap">
      <div class="activity-box">Learn new dance moves</div>
      <div class="activity-box">Yoga</div>
      <div class="activity-box">Pre-Hispanic cooking class &amp; mezcal tasting</div>
      <div class="activity-box">Rappel into a cenote</div>
      <div class="activity-box">Cliff jump into a cenote</div>
      <div class="activity-box">Have picnics</div>
      <div class="activity-box">Take naps</div>
      <div class="activity-box activity-box-custom">Custom: anything you want. Tell me and we'll build it in.</div>
    </div>
    <label for="more-do" class="more-btn"></label>
  </div>
  </div>

  <div class="activity-group activity-group-eat">
  <label for="act2" class="act-cover act-cover-tall"><img src="/images/negro-huitlacoche-spread.jpg" alt="Grilled corn in a husk, a blue corn quesadilla and a pineapple cocktail on a wooden table at Negro Huitlacoche in Tulum" style="object-position:center 35%;"></label>
  <input type="checkbox" class="act-toggle" id="act2">
  <label for="act2" class="activity-group-h">Things you'll eat</label>
  <div class="activity-boxes">
    <div class="activity-box">Mexican and pre-Hispanic food</div>
    <div class="activity-box">Stuff our faces with seasonal fruit</div>
    <div class="activity-box">Meals created by an amazing private chef</div>
    <div class="activity-box activity-box-custom">Custom: anything you want. Tell me and we'll build it in.</div>
  </div>
  </div>

  <div class="activity-group activity-group-learn">
  <label for="act3" class="act-cover"><img src="/images/la-guarida-theater.jpg" alt="A cultural workshop at La Guarida in Tulum" style="object-position:center 50%;"></label>
  <input type="checkbox" class="act-toggle" id="act3">
  <label for="act3" class="activity-group-h">Things you'll learn</label>
  <div class="activity-boxes">
    <div class="activity-box">Get inspired by queer activism in Latin America</div>
    <div class="activity-box">Mexican music, art, and culture</div>
    <div class="activity-box">How Mexicans create community for each other, and the cultural nuances behind it</div>
    <div class="activity-box activity-box-custom">Custom: anything you want. Tell me and we'll build it in.</div>
  </div>
  </div>
  <div class="activity-group activity-group-comfort comfort">
    <div class="act-cover"><img src="/images/tulum-live-drawing-session-comfort-zone.jpeg" alt="A friend posing while another sketches a live drawing in Tulum" style="object-position:center 44%;" loading="lazy"></div>
    <p class="comfort-h">Expand your comfort zone</p>
    <p class="comfort-p">Totally optional. Try something new, with people who get it.</p>
    <div class="stay-chips">
      <span class="stay-chip">Singing classes</span>
      <span class="stay-chip">Pose for a private live drawing session</span>
      <span class="stay-chip">Sensuality and striptease classes</span>
    </div>
  </div>
</section>

<MediaStrip items={stripArt} id="strip-art" label="Art and slow travel moments from our trips" />

<!-- SAMPLE WEEK -->
<section class="faq" id="sample-week">
  <p class="sec-eye">Step 3: What 4 days can look like</p>
  <h2>A sample camp</h2>
  <p class="week-lead">This is a sample 4 day, 5 night camp, our starting trip. Longer trips add more days, like a jungle day or extra free time. Every group is different and every activity is optional. Adventure, Dance, Family, and Team camps add more of their own focus on top of this.</p>
  <div class="faq-list">
    <div class="faq-item">
      <input type="checkbox" id="wk1">
      <label class="faq-q" for="wk1">Arrival night<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Airport pickup, settle into the villa, and taco night: a delicious meal cooked by a private chef.</div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="wk2">
      <label class="faq-q" for="wk2">Day 1: Cenote + traditional Mayan feast<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Swim in a cenote, then share a traditional Mayan feast.</div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="wk3">
      <label class="faq-q" for="wk3">Day 2: River float + cooking class<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Float down canals built by the ancient Mayans, with time to relax and nap. In the evening, a hands-on cooking class and a shared meal of local food.</div></div>
    </div>
