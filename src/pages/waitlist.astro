---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Day Camp Style Group Trips for Queer Grown-Ups | Queerness Experiences" description={"Dates for our 2027 Tulum group trips are coming soon. Leave your email to hear first. Led by a queer Tulum local, for sapphic, queer, and trans travelers."}>

<section class="contact" id="waitlist">
  <p class="sec-eye">Dates coming soon</p>
  <h1>Day camp style<br>group trips for<br>queer grown-ups</h1>
  <p class="contact-lead">Dates for the 2027 Tulum group trips will be announced soon. Leave your details to receive the information first. Led by a queer Tulum local, built for sapphic, queer, and trans travelers.</p>
  <div class="wl-chips">
    <span class="wl-chip">Camp-style trips for grownups</span>
    <span class="wl-chip">Mexican flair</span>
    <span class="wl-chip">First to hear when dates open</span>
  </div>
  <form class="form" name="camp-queerness-waitlist" method="POST" data-netlify="true" action="/thank-you">
    <input type="hidden" name="form-name" value="camp-queerness-waitlist" />
    <div style="display:flex;gap:12px;">
      <div style="flex:1;"><label class="fl">First name</label><input class="fi" type="text" name="first-name" placeholder="First name" required></div>
      <div style="flex:1;"><label class="fl">Last name</label><input class="fi" type="text" name="last-name" placeholder="Last name" required></div>
    </div>
    <div><label class="fl">Pronouns</label><input class="fi" type="text" name="pronouns" placeholder="e.g. she/her, they/them"></div>
    <div><label class="fl">Email</label><input class="fi" type="email" name="email" placeholder="your@email.com" required></div>
    <div><label class="fl">Phone number</label><input class="fi" type="tel" name="phone" placeholder="Include country code, e.g. +1 555 123 4567" required></div>
    <div><label class="fl">Do you have dates in mind? We can build from there</label><input class="fi" type="text" name="dates" placeholder="e.g. March 2027, a week in July, or flexible"></div>
    <div><label class="fl">How many people?</label><input class="fi" type="text" name="group-size" placeholder="Just you, or a group?"></div>
    <div><label class="fl">What are you most excited about?</label><textarea class="fi" name="reason" rows="3" placeholder="Tell me a bit about you" style="resize:vertical;font-family:var(--fb);"></textarea></div>
    <button type="submit" class="fsub">Send me the info</button>
  </form>
</section>

</Layout>

<style>
  .wl-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 var(--s-md);}
  .wl-chip{background:rgba(255,255,255,0.14);border:2px solid rgba(255,255,255,0.85);color:var(--white);border-radius:999px;padding:6px 14px;font-family:var(--fb);font-size:14px;font-weight:700;line-height:1.3;}
</style>
