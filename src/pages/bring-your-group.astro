---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bringing Your Group to Tulum? | Queerness Experiences" description={"Planning to bring your own group to Tulum? Get local consulting and trip planning from a bicultural, bilingual local, focused on local businesses and local experiences."}>

<section class="host" id="host-plan">
  <div class="host-inner">
    <div class="host-text">
      <p class="host-eye">Bringing your group to Tulum?</p>
      <h1>Book your<br>group trip</h1>
      <p>Have a group of 3 or more? Tell me what you're dreaming up and I'll plan the trip around your group, or help you plan your own. Send the form and I'll get back to you to start planning.</p>
      <form class="form" name="group-plan" method="POST" data-netlify="true" action="/thank-you">
        <input type="hidden" name="form-name" value="group-plan" />
        <div style="display:flex;gap:12px;">
          <div style="flex:1;"><label class="fl">First name</label><input class="fi" type="text" name="first-name" placeholder="First name" required></div>
          <div style="flex:1;"><label class="fl">Last name</label><input class="fi" type="text" name="last-name" placeholder="Last name"></div>
        </div>
        <div><label class="fl">Email</label><input class="fi" type="email" name="email" placeholder="your@email.com" required></div>
        <div><label class="fl">Group size</label><input class="fi" type="text" name="group-size" placeholder="How many people (3 or more)"></div>
        <div>
          <label class="fl">Which camps interest you? Pick as many as you like</label>
          <div class="camp-checks">
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Adventure camp" data-key="adventure"> Adventure camp</label>
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Dance camp" data-key="dance"> Dance camp</label>
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Family camp" data-key="family"> Family camp</label>
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Team bonding camp" data-key="team"> Team bonding camp</label>
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Something else"> Something else</label>
            <label class="camp-check"><input type="checkbox" name="camp-type" value="Not sure yet"> Not sure yet</label>
          </div>
        </div>
        <div><label class="fl">Rough dates</label><input class="fi" type="text" name="dates" placeholder="When are you thinking"></div>
        <div><label class="fl">Tell me about your group</label><textarea class="fi" name="message" rows="4" placeholder="What you're hoping to plan or do" style="resize:vertical;font-family:var(--fb);" required></textarea></div>
        <button type="submit" class="fsub">Get excited for your trip →</button>
        <p class="call-alt">Prefer to talk first? <a href="mailto:info@queernessexperiences.com?subject=Book%20a%20call%20about%20a%20group%20trip">Book a call</a></p>
      </form>
    </div>
  </div>
</section>

</Layout>

<script is:inline>
  (function(){
    var k = new URLSearchParams(location.search).get('camp');
    if(!k) return;
    var box = document.querySelector('input[name="camp-type"][data-key="'+k+'"]');
    if(box) box.checked = true;
  })();
</script>

<style is:global>
.host{background:var(--blue);padding:var(--s-lg) var(--s-sm);}
.host-eye{font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--yellow);margin-bottom:var(--s-sm);}
.host h1,.host h2{font-family:var(--ff);font-size:30px;color:var(--white);text-transform:uppercase;line-height:1;margin-bottom:var(--s-sm);}
.host p{font-size:14px;color:rgba(255,255,255,0.75);line-height:1.7;margin-bottom:var(--s-md);max-width:520px;}
.camp-checks{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
@media(max-width:479px){.camp-checks{grid-template-columns:1fr;}}
.camp-check{display:flex;align-items:center;gap:10px;background:var(--white);border:2px solid var(--dark);padding:11px 14px;font-family:var(--fb);font-size:14.5px;color:var(--dark);cursor:pointer;}
.camp-check input{width:18px;height:18px;accent-color:var(--magenta);flex-shrink:0;cursor:pointer;}
.call-alt{font-size:15px !important;color:rgba(255,255,255,0.85) !important;margin:var(--s-sm) 0 0 !important;text-align:center;}
.call-alt a{color:var(--yellow);font-weight:700;text-decoration:underline;}
.host-inner{display:flex;flex-direction:column;gap:var(--s-md);}

@media(min-width:720px){
  .host{padding:var(--s-lg) 40px;}
  .host-inner{max-width:1120px;margin:0 auto;flex-direction:row;align-items:center;gap:48px;}
}
</style>
