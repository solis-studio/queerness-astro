---
// Shared layout: header, footer, global styles. Every page wraps its content in this.
// Props let each page set its own <title> and meta description for SEO.
export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = 'https://queernessexperiences.com/images/group-trips-photo.jpg', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
import '../styles/global.css';
// Meta Pixel: paste the numeric ID from Meta Events Manager to turn tracking on.
const PIXEL_ID = '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph / Twitter card -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Queerness Experiences" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <!-- Cheddar Gothic Stencil is self-hosted. Drop the font file in /public/fonts/ and see global.css @font-face -->

  <!-- Meta Pixel: renders only when PIXEL_ID is set in the frontmatter -->
  {PIXEL_ID && (
  <script is:inline define:vars={{ PIXEL_ID }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID);
    fbq('track', 'PageView');
  </script>
  )}

  <!-- Analytics: Google Analytics 4 + Microsoft Clarity. Skipped for visitors whose browser timezone is in Europe. -->
  <script is:inline>
    (function () {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      if (/^Europe\//.test(tz)) return;
      var g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtag/js?id=G-6S30NEBWNC';
      document.head.appendChild(g);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'G-6S30NEBWNC');
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'yuo1h8kzqh');
    })();
  </script>
</head>
<body>

  <!-- SHARED HEADER -->
  <nav>
    <a href="/" class="logo" style="display:flex;align-items:center;gap:8px;">
      <img src="/images/toucan-logo.png" alt="Queerness Experiences toucan logo" style="width:30px;height:auto;">
      Queerness Experiences
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <div class="nav-r">
      <a href="/about" class="nav-mobile-only">About</a>
      <a href="/blog/queer-tulum-recommendations">Free Tulum Guide</a>
      <a href="/tours">Tours</a>
      <a href="/group-trips">Group Trips</a>
      <a href="/wpath-2026">WPATH</a>
      <a href="/blog">Local Insights</a>
      <a href="/book" class="nav-book">Book</a>
    </div>
  </nav>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- SHARED FOOTER -->
  <footer>
    <a href="/" class="flogo" style="display:flex;align-items:center;gap:8px;">
      <img src="/images/toucan-logo.png" alt="Queerness Experiences toucan logo" style="width:28px;height:auto;">
      Queerness Experiences
    </a>
    <ul class="flinks">
      <li><a href="/about">About</a></li>
      <li><a href="/work-with-me">Work With Me</a></li>
      <li><a href="/blog/queer-tulum-recommendations">Free Tulum Guide</a></li>
      <li><a href="/tours">Tours</a></li>
      <li><a href="/group-trips">Group Trips</a></li>
      <li><a href="/wpath-2026">WPATH 2026</a></li>
      <li><a href="/blog">Local Insights</a></li>
      <li><a href="/book">Book</a></li>
      <li><a href="/policies">Policies</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="https://instagram.com/queerness_experiences_tulum">Instagram</a></li>
    </ul>
    <div class="femail">info@queernessexperiences.com</div>
  </footer>

  <button id="back-to-top" class="back-to-top" aria-label="Back to top">↑</button>
  <script>
    const btt = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      btt.classList.toggle('show', window.scrollY > 600);
    });
    btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
  <script>
    // Hide a scroll arrow once its scroller can't go any further that way.
    const arrows = Array.from(document.querySelectorAll('.strip-arrow, .scroll-arrow'));
    function scrollerFor(btn) {
      const g = btn.closest('.tours-gallery-wrap');
      if (g) return g.querySelector('.tours-gallery');
      const r = btn.closest('.reviews-inner');
      if (r) return r.querySelector('.review-scroll');
      const n = btn.closest('.strip-nav');
      return n ? n.previousElementSibling : null;
    }
    function isLeft(btn) {
      const t = (btn.className + ' ' + (btn.getAttribute('aria-label') || '')).toLowerCase();
      return t.includes('left') || t.includes('previous');
    }
    function updateArrows() {
      arrows.forEach((btn) => {
        const sc = scrollerFor(btn);
        if (!sc) return;
        const atStart = sc.scrollLeft <= 2;
        const atEnd = sc.scrollLeft + sc.clientWidth >= sc.scrollWidth - 2;
        const hide = isLeft(btn) ? atStart : atEnd;
        btn.style.visibility = hide ? 'hidden' : 'visible';
        btn.disabled = hide;
      });
      document.querySelectorAll('.review-scroll-nav, .strip-nav').forEach((nav) => {
        const btns = Array.from(nav.querySelectorAll('button'));
        const allHidden = btns.length > 0 && btns.every((b) => b.disabled);
        nav.style.display = allHidden ? 'none' : '';
      });
    }
    arrows.forEach((btn) => {
      const sc = scrollerFor(btn);
      if (sc) sc.addEventListener('scroll', updateArrows, { passive: true });
    });
    window.addEventListener('resize', updateArrows);
    window.addEventListener('load', updateArrows);
    updateArrows();
  </script>
  <script>
    // Subtle fade-up as sections scroll into view.
    document.documentElement.classList.add('js');
    const targets = document.querySelectorAll('section h2, .sec-eye, .flagship, .gfact, .gcamp, .camp-type, .activity-group, .qtile, .cred, .rcard, .btn-groups');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.08 });
      targets.forEach((t) => { t.classList.add('reveal'); io.observe(t); });
    }
  </script>

</body>
</html>
